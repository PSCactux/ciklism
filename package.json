{
  "name": "ciklism",
  "private": true,
  "version": "0.1.0",
  "description": "Indoor cycling viewer for web, iPhone and Android: Babylon.js + Capacitor with Bluetooth cadence sensors.",
  "license": "MIT",
  "author": "PSCactux",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bake:lighting": "node scripts/bake-lighting.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "sync": "npm run build && cap sync",
    "ios": "cap open ios",
    "android": "cap open android"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@capacitor-community/bluetooth-le": "^8.0.0",
    "@capacitor-community/keep-awake": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "idb": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
